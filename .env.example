# PostgreSQL (matches docker-compose.yml)
DATABASE_URL=postgres://postgres:postgres@localhost:5434/warehouse_management

# Better Auth: any long random string, e.g. `openssl rand -base64 32`
BETTER_AUTH_SECRET=replace-me-with-a-long-random-string

# Must match the address you open in the browser, port included.
BETTER_AUTH_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Groq API key for the AI assistant: https://console.groq.com/keys
GROQ_API_KEY=
